<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Last Call - Bar Inventory</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#121316',
                        cardBg: '#1a1c23',
                        cardBorder: '#2a2e39',
                        accent: '#f59e0b',
                        accentHover: '#d97706',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #121316; color: #f3f4f6; font-family: system-ui, -apple-system, sans-serif; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #121316; }
        ::-webkit-scrollbar-thumb { background: #2a2e39; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row bg-darkBg text-gray-100 selection:bg-accent selection:text-black">

    <!-- SIDEBAR NAVIGATION -->
    <aside class="w-full md:w-64 bg-cardBg border-r border-cardBorder flex flex-col justify-between p-6 shrink-0">
        <div>
            <!-- Logo / Brand -->
            <div class="flex items-center space-x-3 mb-8">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center text-black font-bold text-xl shadow-lg shadow-orange-500/20">
                    <i class="fa-solid fa-wine-glass-empty"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-wide text-white">Last Call</h1>
                    <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Bar Inventory</p>
                </div>
            </div>

            <!-- Nav Links -->
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-gray-400 hover:text-white hover:bg-cardBorder/55">
                    <i class="fa-solid fa-chart-pie w-5"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="switchTab('closing')" id="nav-closing" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-gray-400 hover:text-white hover:bg-cardBorder/50">
                    <i class="fa-solid fa-clipboard-check w-5"></i>
                    <span>Closing Count</span>
                </button>
                <button onclick="switchTab('inventory')" id="nav-inventory" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-gray-400 hover:text-white hover:bg-cardBorder/50">
                    <i class="fa-solid fa-boxes-stacked w-5"></i>
                    <span>Inventory</span>
                </button>
                <button onclick="switchTab('history')" id="nav-history" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-gray-400 hover:text-white hover:bg-cardBorder/50">
                    <i class="fa-solid fa-clock-rotate-left w-5"></i>
                    <span>History</span>
                </button>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="pt-6 border-t border-cardBorder space-y-3">
            <div class="bg-cardBorder/30 p-3 rounded-xl text-xs text-gray-400">
                <p class="font-semibold text-gray-300 mb-1"><i class="fa-solid fa-store text-accent mr-1.5"></i> Active Bars</p>
                <p>Splash Bar & WXYZ Bar</p>
            </div>
            <button onclick="resetData()" class="w-full text-left px-3 py-2 text-xs text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-all flex items-center space-x-2">
                <i class="fa-solid fa-trash-can"></i>
                <span>Reset Demo Data</span>
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 overflow-y-auto p-4 md:p-8">

        <!-- ================= TAB 1: DASHBOARD ================= -->
        <div id="tab-dashboard" class="tab-content space-y-6">
            <!-- Top Banner -->
            <div class="bg-cardBorder/20 border border-cardBorder rounded-2xl p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-xl">
                <div>
                    <h2 class="text-xs uppercase tracking-widest text-accent font-bold mb-1">Tonight's Bar</h2>
                    <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight mb-2">Ready to count the bar?</h3>
                    <p class="text-sm text-gray-400 max-w-xl">Count what's left on the shelf, log the night's usage, and see what needs reordering across Splash & WXYZ Bar.</p>
                </div>
                <button onclick="switchTab('closing')" class="bg-accent hover:bg-accentHover text-black font-semibold px-6 py-3.5 rounded-xl transition-all shadow-lg shadow-amber-500/10 flex items-center space-x-2 shrink-0">
                    <span>Start closing count</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Metric Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between text-gray-400 mb-3">
                        <span class="text-xs font-semibold uppercase tracking-wider">Stock on Hand</span>
                        <i class="fa-solid fa-wine-bottle text-accent"></i>
                    </div>
                    <div class="text-2xl font-bold text-white mb-1" id="dash-total-value">RM 0.00</div>
                    <div class="text-xs text-gray-400" id="dash-active-items">0 active items</div>
                </div>

                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between text-gray-400 mb-3">
                        <span class="text-xs font-semibold uppercase tracking-wider">Below Par</span>
                        <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
                    </div>
                    <div class="text-2xl font-bold text-white mb-1" id="dash-below-par">0</div>
                    <div class="text-xs text-gray-400">Needs reordering</div>
                </div>

                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between text-gray-400 mb-3">
                        <span class="text-xs font-semibold uppercase tracking-wider">Closes This Month</span>
                        <i class="fa-solid fa-calendar-days text-blue-400"></i>
                    </div>
                    <div class="text-2xl font-bold text-white mb-1" id="dash-closes-month">0</div>
                    <div class="text-xs text-gray-400" id="dash-usage-month">RM 0.00 usage logged</div>
                </div>

                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between text-gray-400 mb-3">
                        <span class="text-xs font-semibold uppercase tracking-wider">Last Close</span>
                        <i class="fa-solid fa-clock-rotate-left text-purple-400"></i>
                    </div>
                    <div class="text-lg font-bold text-white mb-1 truncate" id="dash-last-close-date">None yet</div>
                    <div class="text-xs text-gray-400" id="dash-last-close-summary">0 items counted</div>
                </div>
            </div>

            <!-- Reorder List & Recent Closes -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Reorder list -->
                <div class="lg:col-span-2 bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-bold text-white text-lg">Reorder list</h4>
                        <span class="text-xs text-gray-400">Items below par level</span>
                    </div>
                    <div id="dash-reorder-container" class="space-y-3">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Recent Closes -->
                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-bold text-white text-lg">Recent closes</h4>
                        <button onclick="switchTab('history')" class="text-xs text-accent hover:underline">Full history</button>
                    </div>
                    <div id="dash-recent-closes" class="space-y-3">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= TAB 2: CLOSING COUNT ================= -->
        <div id="tab-closing" class="tab-content hidden space-y-6">
            <div>
                <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Count the bar</h2>
                <p class="text-sm text-gray-400 mt-1">Enter what's left at close. Usage and value are calculated as you type.</p>
            </div>

            <!-- Count Settings Header -->
            <div class="bg-cardBg border border-cardBorder rounded-2xl p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Count date</label>
                    <input type="date" id="count-date" class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-accent">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Bar area</label>
                    <select id="count-bar-area" class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-accent">
                        <option value="Splash">Splash Bar</option>
                        <option value="WXYZ Bar">WXYZ Bar</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Counted by</label>
                    <input type="text" id="count-counted-by" placeholder="Your name / Staff name" value="Bartender" class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-accent">
                </div>
                <div class="md:col-span-3">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Notes (optional)</label>
                    <input type="text" id="count-notes" placeholder="Breakages, spillage, comps, deliveries..." class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-accent">
                </div>
            </div>

            <!-- Filter & Search for Count -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-cardBg border border-cardBorder rounded-2xl p-4">
                <div class="relative w-full sm:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400 text-sm"></i>
                    <input type="text" id="count-search" oninput="renderClosingTable()" placeholder="Search items..." class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl pl-11 pr-4 py-2.5 text-sm text-white focus:outline-none focus:border-accent">
                </div>
                <div class="flex flex-wrap gap-2 w-full sm:w-auto" id="count-category-filters">
                    <button onclick="setCountCategory('All')" class="count-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-accent text-black transition-all">All</button>
                    <button onclick="setCountCategory('Spirits')" class="count-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cardBorder/50 text-gray-300 hover:bg-cardBorder transition-all">Spirits (Shots)</button>
                    <button onclick="setCountCategory('Beer')" class="count-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cardBorder/50 text-gray-300 hover:bg-cardBorder transition-all">Beer (Btls/Cans)</button>
                    <button onclick="setCountCategory('Wine')" class="count-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cardBorder/50 text-gray-300 hover:bg-cardBorder transition-all">Wine/Champagne (Glasses)</button>
                    <button onclick="setCountCategory('Mixers')" class="count-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cardBorder/50 text-gray-300 hover:bg-cardBorder transition-all">Mixers</button>
                </div>
            </div>

            <!-- Bulk action bar -->
            <div class="flex justify-between items-center bg-cardBorder/20 px-4 py-3 rounded-xl text-xs text-gray-400">
                <span>Quick Actions: Fill closing with opening quantities</span>
                <div class="space-x-3">
                    <button onclick="bulkFillClosing()" class="text-accent hover:underline font-semibold">Closing = Opening</button>
                    <span>|</span>
                    <button onclick="clearClosingEntries()" class="text-red-400 hover:underline font-semibold">Clear entries</button>
                </div>
            </div>

            <!-- Closing Count Table -->
            <div class="bg-cardBg border border-cardBorder rounded-2xl overflow-x-auto shadow-xl">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-cardBorder text-xs uppercase tracking-wider text-gray-400 bg-cardBorder/20">
                            <th class="p-4">Item</th>
                            <th class="p-4">Bar</th>
                            <th class="p-4">Category / Unit Rule</th>
                            <th class="p-4 text-right">Opening</th>
                            <th class="p-4 text-right">Closing Count</th>
                            <th class="p-4 text-right">Used</th>
                            <th class="p-4 text-right">Usage Value (RM)</th>
                        </tr>
                    </thead>
                    <tbody id="closing-table-body" class="divide-y divide-cardBorder/50 text-sm">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>

            <!-- Save closing count sticky bar / button -->
            <div class="flex justify-end pt-4">
                <button onclick="saveClosingCount()" class="bg-accent hover:bg-accentHover text-black font-bold px-8 py-4 rounded-xl shadow-xl shadow-amber-500/10 flex items-center space-x-2 transition-all">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Save closing count & log usage</span>
                </button>
            </div>
        </div>

        <!-- ================= TAB 3: INVENTORY ================= -->
        <div id="tab-inventory" class="tab-content hidden space-y-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">What you stock</h2>
                    <p class="text-sm text-gray-400 mt-1">Par levels and costs drive your count sheet, usage value, and reorder list.</p>
                </div>
                <button onclick="openAddItemModal()" class="bg-accent hover:bg-accentHover text-black font-semibold px-5 py-3 rounded-xl transition-all shadow-lg flex items-center space-x-2">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add item</span>
                </button>
            </div>

            <!-- Bar Selector Tabs for Inventory -->
            <div class="flex items-center space-x-2 bg-cardBg border border-cardBorder p-1.5 rounded-2xl w-fit">
                <button onclick="setInventoryBarFilter('All bars')" id="inv-bar-all" class="px-4 py-2 rounded-xl text-xs font-semibold bg-accent text-black transition-all">All bars</button>
                <button onclick="setInventoryBarFilter('Splash')" id="inv-bar-splash" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400 hover:text-white transition-all">Splash</button>
                <button onclick="setInventoryBarFilter('WXYZ Bar')" id="inv-bar-wxyz" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400 hover:text-white transition-all">WXYZ Bar</button>
            </div>

            <!-- Inventory Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Active Items</span>
                    <div class="text-2xl font-bold text-white mt-2" id="inv-active-count">0</div>
                    <div class="text-xs text-gray-400 mt-1">Items on file</div>
                </div>
                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Stock on Hand Value</span>
                    <div class="text-2xl font-bold text-white mt-2" id="inv-total-val">RM 0.00</div>
                    <div class="text-xs text-gray-400 mt-1">At current unit costs</div>
                </div>
                <div class="bg-cardBg border border-cardBorder rounded-2xl p-6">
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Below Par Items</span>
                    <div class="text-2xl font-bold text-white mt-2" id="inv-below-par-count">0</div>
                    <div class="text-xs text-gray-400 mt-1">Needs reordering</div>
                </div>
            </div>

            <!-- Search & Category Filters -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-cardBg border border-cardBorder rounded-2xl p-4">
                <div class="relative w-full sm:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400 text-sm"></i>
                    <input type="text" id="inventory-search" oninput="renderInventoryTable()" placeholder="Search items or suppliers..." class="w-full bg-cardBorder/50 border border-cardBorder rounded-xl pl-11 pr-4 py-2.5 text-sm text-white focus:outline-none focus:border-accent">
                </div>
                <div class="flex flex-wrap gap-2" id="inventory-category-filters">
                    <button onclick="setInventoryCategory('All')" class="inv-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-accent text-black transition-all">All</button>
                    <button onclick="setInventoryCategory('Spirits')" class="inv-cat-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cardBorder/50 text-gray-
